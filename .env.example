# Environment example

# Discord bot token (do NOT commit your real token)
TOKEN=

# (Optional) Guild id to register commands to during development
GUILD_ID=

# Database URL. Examples:
# SQLite (local dev):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# (Optional)
PORT=3000
